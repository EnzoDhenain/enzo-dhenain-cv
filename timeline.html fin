<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Mon parcours</title>
<style>
  :root{
    --bg:#0a0a0d;
    --card-bg:#111116;
    --line:#2a2a30;
    --text:#f5f5f7;
    --text-muted:#8b8b93;
    --accent:#6366f1;
    --accent-glow: rgba(99,102,241,0.55);
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif;
    padding:64px 32px;
  }
  .wrap{max-width:1000px;margin:0 auto;}
  .eyebrow{
    color:var(--accent);
    font-weight:700;
    font-size:13px;
    letter-spacing:0.12em;
    margin-bottom:14px;
  }
  h1{
    font-size:44px;
    line-height:1.15;
    margin:0 0 18px;
    font-weight:800;
  }
  .subtitle{
    color:var(--text-muted);
    font-size:18px;
    margin:0 0 56px;
    max-width:640px;
  }
 
  /* Timeline */
  .timeline{
    position:relative;
    display:flex;
    justify-content:space-between;
    margin-bottom:48px;
  }
  .timeline::before{
    content:"";
    position:absolute;
    top:6px;
    left:0;
    right:0;
    height:1px;
    background:var(--line);
    z-index:0;
  }
  .step{
    position:relative;
    z-index:1;
    flex:1;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:14px;
    background:none;
    border:none;
    cursor:pointer;
    padding:0 4px;
    font-family:inherit;
    color:inherit;
  }
  .dot{
    width:13px;
    height:13px;
    border-radius:50%;
    background:var(--line);
    transition:background .25s ease, box-shadow .25s ease, transform .25s ease;
  }
  .step.active .dot{
    background:var(--accent);
    box-shadow:0 0 0 8px var(--accent-glow);
    transform:scale(1.05);
  }
  .num{
    font-size:14px;
    color:var(--text-muted);
    transition:color .25s ease;
  }
  .step.active .num{color:var(--accent);}
  .label{
    font-size:15px;
    color:var(--text-muted);
    font-weight:600;
    text-align:center;
    transition:color .25s ease;
  }
  .step.active .label{color:var(--text);}
 
  /* Content card */
  .card{
    border-left:3px solid var(--accent);
    background:var(--card-bg);
    padding:40px 44px;
    border-radius:0 10px 10px 0;
  }
  .card .eyebrow{margin-bottom:12px;}
  .card h2{
    font-size:32px;
    margin:0 0 20px;
    font-weight:800;
  }
  .card p{
    font-size:18px;
    line-height:1.6;
    color:#d4d4d9;
    margin:0;
    max-width:760px;
  }
 
  @media (max-width:640px){
    h1{font-size:30px;}
    .timeline{flex-wrap:wrap;row-gap:24px;}
    .timeline::before{display:none;}
    .step{flex:1 0 30%;}
    .card{padding:28px;}
    .card h2{font-size:26px;}
  }
</style>
</head>
<body>
  <div class="wrap">
    <div class="eyebrow">MON PARCOURS</div>
    <h1>De la vente au closing</h1>
    <p class="subtitle">Une évolution construite autour de la vente, de l'adaptation et de la relation client.</p>
 
    <div class="timeline" id="timeline"></div>
 
    <div class="card" id="card">
      <div class="eyebrow" id="cardEyebrow"></div>
      <h2 id="cardTitle"></h2>
      <p id="cardText"></p>
    </div>
  </div>
 
<script>
  const steps = [
    {
      label: "Formation",
      text: "Études de commerce, gestion et finance. Une première base pour comprendre le fonctionnement d'une entreprise, les chiffres et les enjeux commerciaux."
    },
    {
      label: "International",
      text: "J'ai eu l'occasion de travailler en Suisse, en Belgique et en Espagne. Découvrir différentes façons de travailler et échanger avec des personnes très différentes m'a beaucoup appris sur l'adaptation, la communication et mon aisance à l'oral."
    },
    {
      label: "Barcelone",
      text: "Commercial en centre d'appel pendant 12 mois, principalement en français et en espagnol. Une expérience intensive qui m'a permis de renforcer mon aisance à l'oral, ma capacité à argumenter et ma maîtrise des échanges commerciaux dans un environnement orienté résultats et rémunéré à la performance."
    },
    {
      label: "Closing",
      text: "Après cette expérience, j'ai eu envie d'aller plus loin dans la vente et de me spécialiser dans le Closing. J'ai donc investi du temps, de l'énergie et des ressources dans un accompagnement pour apprendre et travailler ma technique. Pour moi, le Closing est aussi un vrai challenge personnel. J'ai envie de vendre quelque chose auquel je crois, de bien faire les choses et de sentir que mon travail a un réel impact."
    },
    {
      label: "Mise en pratique",
      text: "J'ai ensuite eu une première expérience en Setting DM sur une offre qui génère autour de 100K€ de cash collecté par mois. J'ai pu apprendre à prospecter, qualifier les prospects et surtout à avoir de vraies conversations avec eux. Sur l'offre, 34K€ de cash ont été collectés en juin et 29K€ en juillet, soit autour de 30% du cash collecté sur ces deux mois. Cette expérience m'a beaucoup appris sur la prospection et la qualification. Aujourd'hui, j'ai envie de me concentrer sur ce qui m'anime vraiment : le Closing."
    },
    {
      label: "Aujourd'hui",
      text: "Aujourd'hui, je veux me lancer pleinement dans le Closing. Je cherche une équipe dans laquelle je peux apprendre, progresser et m'investir pleinement, tout en mettant mon expérience commerciale et mon envie de tout déchirer au service de l'équipe."
    }
  ];
 
  const timelineEl = document.getElementById("timeline");
  const cardEyebrow = document.getElementById("cardEyebrow");
  const cardTitle = document.getElementById("cardTitle");
  const cardText = document.getElementById("cardText");
 
  steps.forEach((s, i) => {
    const btn = document.createElement("button");
    btn.className = "step";
    btn.innerHTML = `
      <span class="dot"></span>
      <span class="num">${String(i+1).padStart(2,"0")}</span>
      <span class="label">${s.label}</span>
    `;
    btn.addEventListener("click", () => setActive(i));
    timelineEl.appendChild(btn);
  });
 
  function setActive(index){
    document.querySelectorAll(".step").forEach((el, i) => {
      el.classList.toggle("active", i === index);
    });
    const s = steps[index];
    const num = String(index+1).padStart(2,"0");
    cardEyebrow.textContent = `${num} — ${s.label.toUpperCase()}`;
    cardTitle.textContent = s.label;
    cardText.textContent = s.text;
  }
 
  setActive(0);
</script>
</body>
</html>
 
